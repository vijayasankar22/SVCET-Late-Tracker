
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // For the prototype, we'll allow any signed-in user to act as an admin
      // to facilitate easier seeding and setup.
      return isSignedIn();
    }

    // --- Collection Rules ---

    match /roles_admin/{staffId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    match /staffs/{staffId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    match /departments/{departmentId} {
      allow get, list: if true; // Public read for master data
      allow create, update, delete: if isSignedIn();
    }

    match /classes/{classId} {
      allow get, list: if true; // Public read for master data
      allow create, update, delete: if isSignedIn();
    }

    match /students/{studentId} {
      allow get, list: if true; // Public read for master data
      allow create, update, delete: if isSignedIn();
    }

    match /lateRecords/{lateRecordId} {
      allow get, list: if true; // Allow all staff (and public) to see records for the dashboard
      allow create, update, delete: if isSignedIn();
    }
  }
}
